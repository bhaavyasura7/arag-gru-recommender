/artifacts/*
!/artifacts/llm_cache/
!/artifacts/lists/
!/artifacts/gru/
!/artifacts/gru_text/
!/artifacts/sasrec/
!/artifacts/predictions/
/.venv/
.venv/
node_modules/
.env
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/
.DS_Store

# agent-browser local screenshots
.agent-screenshots/
