# Root-anchored ignores (a bare "data/" would swallow any package named data/)
# data: track the review CSVs, cleaned parquet tables and manifest; the 437 MB product
# file exceeds GitHub's 100 MB limit (re-download it with `make data`)
/data/raw/meta_Video_Games.jsonl
# artifacts: ignore everything except the small files needed to verify and replay the run at $0
/artifacts/*
!/artifacts/llm_cache/
!/artifacts/lists/
!/artifacts/gru/
!/artifacts/gru_text/
!/artifacts/sasrec/
!/artifacts/predictions/
/.venv/
.venv/
node_modules/
.env
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/
.DS_Store

